<resources>
    <string name="app_name">OpenSave</string>

    <!-- 首次使用向导 -->
    <string name="wizard_title">欢迎使用 OpenSave</string>
    <string name="wizard_step_counter">第 %1$d / %2$d 步</string>
    <string name="wizard_back">上一步</string>
    <string name="wizard_next">下一步</string>
