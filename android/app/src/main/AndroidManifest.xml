<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      免 root 读取 /storage/emulated/0/Android/data/<pkg>：Eden、Yuzu、Winlator
      一类模拟器与容器的存档都在那里，而 SAF 从 Android 11 起禁止用户选中该子树。
      持有时 FUSE 不再做 scoped-storage 过滤，与 MT 管理器同一条通道。
      未授予时不影响任何其他功能，路径型来源会显示"需要 Root"。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- API 30 以下仍是旧存储模型，靠这两个运行时权限读公共目录。 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!--
      Network batches (上传待传, 检查云端更新, 安全恢复云端较新) run as an
      expedited WorkManager job in a dataSync foreground service, so a
      long upload is not cut off at the background time limit. Without the
      notification permission the job still runs; only its notice is hidden.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      Handheld consoles (e.g. AYN Odin2) drive the app with a built-in gamepad;
      neither a gamepad nor a touchscreen is required, so phones and handhelds
      both install it. Leanback is deliberately not declared: this is not a TV app.
    -->
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!--
      Save discovery only needs launchable user apps plus the emulator/container
      packages that have dedicated storage layouts. Do not request the broad
      QUERY_ALL_PACKAGES permission: it is unnecessary for SAF or Root scans
      and prevents ordinary distribution.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="dev.eden.eden_emulator" />
        <package android:name="dev.eglantine.eglantine" />
        <package android:name="dev.eden.nx2" />
        <package android:name="com.xiaoji.egggame" />
        <package android:name="com.winlator" />
        <package android:name="com.ludashi.benchmark" />
        <package android:name="com.droiddeck.launcher" />
        <package android:name="org.yuzu.yuzu_emu" />
        <package android:name="org.yuzu.yuzu_emu.ea" />
        <package android:name="dev.suyu.suyu_emu" />
        <package android:name="org.sudachi.sudachi_emu" />
        <package android:name="org.citron.citron_emu" />
    </queries>
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenSave"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A pairing QR code opens the app directly: savevault://pair?v=1&server=…&code=… -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="savevault" android:host="pair" />
            </intent-filter>
        </activity>
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
